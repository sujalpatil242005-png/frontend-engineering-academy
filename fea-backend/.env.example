# Copy this file to .env and fill in real values.
# Nothing here needs a paid service — SQLite is a local file, and
# OAuth apps are free to create.

PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Any long random string — used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Optional — leave blank to disable Google login (email/password still works)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — leave blank to disable GitHub login (email/password still works)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
